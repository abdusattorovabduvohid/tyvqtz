generator client {
  provider = "prisma-client-js"
}

// Postgres, а не SQLite: на Vercel файловая система только для чтения и
// у каждого запроса свой контейнер — файловая база там работать не может.
// Имена переменных — как их создаёт интеграция Vercel Postgres:
//   POSTGRES_PRISMA_URL      — через пул (pgbouncer), для обычных запросов
//   POSTGRES_URL_NON_POOLING — прямое соединение, нужно для db push/миграций
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ──────────────────────────── RBAC ────────────────────────────

model Role {
  id           String   @id @default(cuid())
  nameUz       String   @unique
  nameRu       String?
  isSuperAdmin Boolean  @default(false)
  // JSON: { "<section>": ["view","create","update","delete"], ... }
  permissions  String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique // логин для входа
  firstName    String // имя
  lastName     String // фамилия
  middleName   String? // отчество
  photo        String? // путь к фотографии
  seh          String? // номер цеха работника (2, 8, 15, 28 …); у админов пусто
  passwordHash String
  isActive     Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Уведомления ──
  // chat id в телеграме; пусто — телеграм не подключён
  telegramChatId   String? @unique
  telegramUsername String?
  // одноразовый код для команды /start <код> в боте
  telegramLinkCode String? @unique

  // ── Контроль доступа ──
  // Онлайн-статус. Обновляется не чаще раза в минуту (lib/presence.ts):
  // писать в базу на каждый запрос — лишняя нагрузка на пул Supabase.
  lastSeenAt   DateTime?
  // Версия сессии, лежит внутри JWT. Кнопка «Выкинуть» увеличивает её —
  // и все выданные этому человеку токены разом становятся негодными.
  // Отдельная таблица сессий для этого не нужна.
  tokenVersion Int       @default(0)

  loginLogs              LoginLog[]
  pushSubscriptions      PushSubscription[]
  assignedWagonStages    WagonStageAssignment[]
  startedStages          WagonStage[]            @relation("StageStartedBy")
  finishedStages         WagonStage[]            @relation("StageFinishedBy")
  wagonCreationApprovals WagonCreationApproval[] @relation("WagonCreationApprover")
  daySignoffs            WagonStageDaySignoff[]
}

// ──────────────────────────── Вагоны ────────────────────────────

model WagonType {
  id        String   @id @default(cuid())
  nameUz    String   @unique
  nameRu    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wagons Wagon[]
}

// Шаблон этапа = «Позиция» из бумажного плана.
// Это не одна работа, а НАБОР работ: у каждой своё время, а у позиции —
// общее время (сумма), бригада и цех.
model Stage {
  id              String   @id @default(cuid())
  number          Int      @unique // Позиция №
  nameUz          String // название позиции (узб)
  nameRu          String? // название позиции (рус)
  // Сумма часов работ × 3600. Не вводится руками — считается из works.
  // Оставлено полем, потому что на нём держится таймер этапа.
  durationSeconds Int
  workerCount     Int? // Количество работников на позицию
  note            String? // Примечание, например «2-цех»
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  works StageWork[]
}

// Строка «Наименования работ» внутри позиции.
model StageWork {
  id          String  @id @default(cuid())
  stageId     String
  stage       Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  number      Int // № работы внутри позиции
  nameUz      String
  nameRu      String?
  hours       Float // «Время работа»: 12ч, 2ч …
  seh         String? // цех этой работы — в бумаге у каждой работы свой (№8, №2 …)
  workerCount Int? // количество работников на работу
  // «День» из бумаги: в какие рабочие дни позиции делается эта работа.
  // 1 день → dayFrom = dayTo = 1; «2-кун 3-кун» → dayFrom 2, dayTo 3.
  // null у старых строк — тогда дни считаются по-старому (8 ч = 1 день).
  dayFrom     Int?
  dayTo       Int?

  @@unique([stageId, number])
}

model Wagon {
  id             String    @id @default(cuid())
  nameUz         String // название вагона (узб)
  nameRu         String? // название вагона (рус)
  number         String // номер вагона
  wagonTypeId    String
  wagonType      WagonType @relation(fields: [wagonTypeId], references: [id])
  status         String    @default("pending") // pending | in_progress | done
  // статус подтверждения создания вагона (1-я фаза согласования)
  creationStatus String    @default("approved") // pending | approved | rejected
  // «Ish boshlanish sanasi» из бумаги — задаётся при создании.
  // От неё считается план дат этапов. Пусто → берём createdAt.
  plannedStart   DateTime?
  // «Ish tugash sanasi» — обычно считается автоматически, но можно задать вручную.
  plannedEnd     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stages            WagonStage[]
  creationApprovals WagonCreationApproval[]
}

// Согласование СОЗДАНИЯ вагона (1-я фаза, отдельная группа людей, по очереди)
model WagonCreationApproval {
  id        String    @id @default(cuid())
  wagonId   String
  wagon     Wagon     @relation(fields: [wagonId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("WagonCreationApprover", fields: [userId], references: [id], onDelete: Cascade)
  order     Int       @default(0)
  decision  String    @default("pending") // pending | approved | denied
  comment   String?
  decidedAt DateTime?

  @@unique([wagonId, userId])
}

// Экземпляр этапа конкретного вагона (снимок шаблона + состояние/таймер)
model WagonStage {
  id              String    @id @default(cuid())
  wagonId         String
  wagon           Wagon     @relation(fields: [wagonId], references: [id], onDelete: Cascade)
  number          Int
  nameUz          String
  nameRu          String?
  // снимок позиции на момент создания вагона (сумма часов работ × 3600)
  durationSeconds Int
  workerCount     Int?
  note            String?
  status          String    @default("pending") // pending | in_progress | done | blocked
  startedAt       DateTime?
  startedById     String? // кто запустил этап
  startedBy       User?     @relation("StageStartedBy", fields: [startedById], references: [id])
  finishedAt      DateTime?
  finishedById    String? // кто завершил этап
  finishedBy      User?     @relation("StageFinishedBy", fields: [finishedById], references: [id])
  // причина отклонения от норматива — обязательна при завершении
  // (просрочено — почему поздно; раньше срока — почему раньше)
  finishComment   String?

  assignments WagonStageAssignment[]
  works       WagonStageWork[]
  daySignoffs WagonStageDaySignoff[]

  @@unique([wagonId, number])
}

// Приёмка одного рабочего дня позиции. Каждый назначенный (ответственный)
// подходит к вагону, смотрит работу за этот день и ставит подпись (галочку).
// День принят, когда подписали все назначенные; позиция готова — когда
// приняты все её дни. Ни таймера, ни «Старт/Завершить» тут нет.
model WagonStageDaySignoff {
  id           String     @id @default(cuid())
  wagonStageId String
  wagonStage   WagonStage @relation(fields: [wagonStageId], references: [id], onDelete: Cascade)
  dayIndex     Int // номер рабочего дня внутри позиции, с 1
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // accepted — принял работу дня; rejected — не принял, тогда нужен comment
  decision     String     @default("accepted")
  comment      String?
  signedAt     DateTime   @default(now())

  @@unique([wagonStageId, dayIndex, userId])
}

// Снимок строки «Наименования работ» для конкретного вагона.
// Шаблон потом меняется — у вагона остаётся то, по чему его строили.
model WagonStageWork {
  id           String     @id @default(cuid())
  wagonStageId String
  wagonStage   WagonStage @relation(fields: [wagonStageId], references: [id], onDelete: Cascade)
  number       Int
  nameUz       String
  nameRu       String?
  hours        Float
  seh          String?
  workerCount  Int?
  // «День» из бумаги — как в StageWork (см. комментарий там)
  dayFrom      Int?
  dayTo        Int?

  @@unique([wagonStageId, number])
}

model WagonStageAssignment {
  id           String     @id @default(cuid())
  wagonStageId String
  wagonStage   WagonStage @relation(fields: [wagonStageId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // порядковый номер ответственного в вагоне (для отображения и drag&drop)
  order Int @default(0)

  // решение исполнителя по запуску этапа
  decision  String    @default("pending") // pending | approved | denied
  comment   String? // причина отказа
  decidedAt DateTime?

  // может ли этот человек нажимать «Старт» / «Завершить».
  // Разрешение (decision) дают все назначенные, а кнопки — только эти.
  // default(true) — чтобы у вагонов, созданных до появления поля, поведение не изменилось.
  canExecute Boolean @default(true)

  @@unique([wagonStageId, userId])
}

// ──────────────────────────── Уведомления ────────────────────────────

// Подписка браузера на Web Push. У одного человека их несколько:
// телефон, рабочий компьютер, планшет — каждое устройство своя запись.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // адрес push-сервиса браузера — он же уникальный ключ устройства
  endpoint  String   @unique
  p256dh    String // ключ шифрования из подписки
  auth      String // секрет из подписки
  userAgent String? // чтобы человек узнал своё устройство в списке
  createdAt DateTime @default(now())
  // когда последний раз успешно доставили — по нему чистим мёртвые подписки
  lastOkAt  DateTime @default(now())
  // подряд идущие отказы push-сервиса (401/403 — не тот VAPID-ключ и т.п.).
  // Сразу не удаляем: ключ мог временно не подхватиться на сервере. После
  // порога подписку выкидываем, а браузер переоформит её сам (PushAutoHeal).
  failCount Int      @default(0)

  @@index([userId])
}

// ──────────────────────────── Контроль доступа ────────────────────────────

// Журнал входов. Пишем и успешные попытки, и неудачные — неудачные даже
// важнее: по ним видно подбор пароля, и по ним же считается блокировка
// (lib/login-guard.ts). Отдельной таблицы для блокировок поэтому не нужно.
model LoginLog {
  id String @id @default(cuid())

  // null — такого логина в системе нет: кто-то подбирает чужую учётку
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // что именно ввели в поле логина: нужно и когда пользователя не существует
  loginTried String
  success    Boolean
  // почему не пустили: no_user | bad_password | inactive | locked
  reason     String?

  ip        String?
  userAgent String?
  // разобранный userAgent, чтобы не парсить его заново при каждой отрисовке
  device    String? // «Samsung SM-A536B»; у iPhone только «iPhone» — Apple скрывает
  os        String?
  browser   String?

  // город по IP: приблизительно, на мобильном интернете часто врёт
  ipCity    String?
  ipCountry String?

  // GPS — точно, но только если человек дал разрешение в браузере
  gpsLat      Float?
  gpsLng      Float?
  gpsAccuracy Float? // радиус погрешности в метрах

  createdAt DateTime @default(now())

  // по этому индексу идёт и лента журнала, и подсчёт неудачных попыток
  @@index([createdAt])
  @@index([loginTried, createdAt])
  @@index([userId, createdAt])
}

// Настройки, которые меняются на ходу, без деплоя.
//
// lib/features.ts остаётся для разделов, которые включает разработчик: там
// значение зашито в код. Сюда попадает то, чем суперадмин должен управлять
// сам, с телефона, и что обязано подействовать в ту же секунду.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String? // id суперадмина, который переключил
}
